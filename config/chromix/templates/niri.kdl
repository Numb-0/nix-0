// Generated by chromix from a matugen template. Changes are lost on the
// next theme switch. Included by the niri config (config/niri).

layout {
    // Same roles and alpha as chromix's Hyprland borders
    focus-ring {
        active-color "#{{colors.primary.default.hex_stripped}}ee"
        inactive-color "#{{colors.outline_variant.default.hex_stripped}}aa"
        urgent-color "#{{colors.error.default.hex_stripped}}"
    }
}
